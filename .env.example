# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://gnw:changeme@localhost:5432/gnw

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Session cookies ───────────────────────────────────────────────────────────
# MUST be at least 32 characters, random, kept secret
# Generate: openssl rand -hex 32
COOKIE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to true ONLY if you want users to self-register (default: false)
ALLOW_SELF_REGISTRATION=false

# ── PostgreSQL (docker-compose only) ─────────────────────────────────────────
POSTGRES_DB=gnw
POSTGRES_USER=gnw
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
