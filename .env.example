# GNW production environment template.
# Never commit real secrets. Use a secret manager in production.

# Database
DATABASE_URL=postgresql://gnw_app:REPLACE_WITH_PASSWORD@db.example.internal:5432/gnw?sslmode=verify-full
GNW_POSTGRES_SSL_REQUIRED=true

# Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=false

# Session/auth
COOKIE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ALLOW_SELF_REGISTRATION=false

# Executor / governed side effects
EXECUTOR_URL=https://executor.example.internal
EXECUTOR_SECRET=REPLACE_WITH_32_BYTE_SECRET
GNW_REQUIRE_SIGNED_GRANTS=true
GNW_GRANT_ISSUER=gnw-production
GNW_GRANT_PRIVATE_KEY_PEM=REPLACE_WITH_PRIVATE_KEY
GNW_GRANT_PUBLIC_KEY_PEM=REPLACE_WITH_PUBLIC_KEY
GNW_LEASE_PRIVATE_KEY_PEM=REPLACE_WITH_PRIVATE_KEY

# Runtime attestation. Production restricted actions fail closed until these are supplied.
GNW_REQUIRE_TEE_ATTESTATION=true
GNW_TEE_ATTESTATION_ISSUER=REPLACE_WITH_APPROVED_ATTESTATION_VERIFIER
GNW_TEE_ATTESTATION_PUBLIC_KEY_PEM=REPLACE_WITH_ATTESTATION_VERIFIER_PUBLIC_KEY
GNW_TEE_ATTESTATION_MEASUREMENT=REPLACE_WITH_EXPECTED_64_HEX_MEASUREMENT
GNW_TEE_ATTESTATION_MAX_AGE_MS=120000
# Signed evidence emitted by the production remote-attestation verifier.
GNW_TEE_ATTESTATION_EVIDENCE_JSON=REPLACE_WITH_CURRENT_SIGNED_TEE_EVIDENCE_JSON

# Threshold trust anchor. The participant public keys are controlled by separate trust domains.
# Do not generate this value in application code; provision it through the production secret manager.
GNW_REQUIRE_MPC_TRUST_ANCHOR=true
GNW_MPC_TRUST_ANCHOR_JSON={"threshold":2,"requireTee":true,"participants":{"operator-a":"REPLACE_WITH_ED25519_PUBLIC_KEY","operator-b":"REPLACE_WITH_ED25519_PUBLIC_KEY","operator-c":"REPLACE_WITH_ED25519_PUBLIC_KEY"}}
# Current M-of-N evidence over action/measurement/nonce from the independent trust service.
GNW_MPC_TRUST_ANCHOR_EVIDENCE_JSON=REPLACE_WITH_CURRENT_THRESHOLD_EVIDENCE_JSON

# Explicit outbound allowlist. Comma-separated hostnames, no URLs.
GNW_EGRESS_ALLOW_LIST=api.openai.com
CORS_ORIGIN=https://gnw.example.com

# LLM / research
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_WITH_API_KEY
LLM_MODEL=REPLACE_WITH_APPROVED_MODEL
LLM_TIMEOUT_MS=45000
GNW_DEEP_RESEARCH_BASE_URL=https://api.openai.com/v1
GNW_DEEP_RESEARCH_API_KEY=REPLACE_WITH_API_KEY
GNW_DEEP_RESEARCH_MODEL=gpt-5.6-sol
GNW_DEEP_RESEARCH_MAX_TOOL_CALLS=50
GNW_DEEP_RESEARCH_TIMEOUT_MS=3600000
GNW_DEEP_RESEARCH_USE_CODE_INTERPRETER=false
GNW_DEEP_RESEARCH_ALLOWED_DOMAINS=example.com

# Artifact storage
STORAGE_DRIVER=local
ARTIFACT_DIR=/data/artifacts
# True only when the filesystem is genuinely shared and backed by approved RWX storage.
GNW_SHARED_STORAGE_CONFIRMED=false

# Optional integrations
VIDEO_PROVIDER=stub
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
NOTIFY_WEBHOOK_URL=

# Request controls
GNW_MAX_REQUEST_BODY_BYTES=10485760
GNW_RATE_LIMIT_WINDOW_MS=60000
GNW_RATE_LIMIT_MAX_REQUESTS=120
