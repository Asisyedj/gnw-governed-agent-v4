{
  "name": "gnw-governed-agent-v4",
  "version": "1.0.0",
  "description": "GNW Governed Agent — production control plane",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/app.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "verify:production": "node scripts/verify-production-closure.mjs",
    "verify:production:env": "node scripts/preflight-production.mjs",
    "verify:rls": "node scripts/test-rls.mjs",
    "start": "node dist/server/app.js",
    "verify:invariants": "vitest run src/tests/unit/verified-data.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.0.1",
    "eslint": "^9.9.0",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
