      "evidence": "signed-governance-attestation",
      "blocking": true,
      "source": "https://pkcert.gov.pk/grc-policies.asp"
    },
    {
      "id": "PISF-IAM-001",
      "regime": "PISF",
      "title": "Identity, access and privileged-access controls are tested",
      "requiredWhen": ["PISF_2026"],
