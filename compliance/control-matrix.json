{
  "schema": "GNW.PK.ControlMatrix.v1",
  "version": "2026.10.03",
  "controls": [
    {
      "id": "APP-001",
      "regime": "Applicability",
      "title": "Applicability determination is versioned and complete",
      "requiredWhen": ["always"],
      "automation": ["node scripts/verify-compliance-matrix.mjs"],
      "evidence": "applicability-digest",
      "blocking": true,
      "source": "https://pkcert.gov.pk/uploads/2026/03/PISF-Merged-Version.pdf"
    },
    {
      "id": "PPRA-001",
      "regime": "PPRA",
      "title": "Current procurement rule/SBD basis is recorded",
      "requiredWhen": ["PPRA_2026"],
      "automation": ["release-evidence"],
      "evidence": "procurement-reference",
      "blocking": true,
      "source": "https://epms.ppra.gov.pk/public/procurement-rules"
    },
    {
      "id": "PPRA-002",
      "regime": "PPRA",
      "title": "Security specifications, evaluation criteria and applicable standards are preserved",
      "requiredWhen": ["PPRA_2026"],
      "automation": ["release-evidence"],
      "evidence": "procurement-security-clauses",
      "blocking": true,
      "source": "https://epms.ppra.gov.pk/public/procurement-rules"
    },
    {
      "id": "SBP-TG-001",
      "regime": "SBP",
      "title": "Technology governance and risk assessment evidence covers the exact release scope",
      "requiredWhen": ["SBP_TECH_GOVERNANCE"],
      "automation": ["release-evidence"],
      "evidence": "signed-risk-assessment",
      "blocking": true,
      "source": "https://www.sbp.org.pk/circulars/bprd-circular-no-05-of-2017"
    },
    {
      "id": "SBP-OUT-001",
      "regime": "SBP",
      "title": "Outsourcing risk/materiality, supplier due diligence and contractual controls are evidenced",
      "requiredWhen": ["SBP_OUTSOURCING"],
      "automation": ["release-evidence"],
      "evidence": "outsourcing-assessment",
      "blocking": true,
      "source": "https://www.sbp.org.pk/circulars/bprd-circular-no-06-of-2017"
    },
    {
      "id": "SBP-CLOUD-001",
      "regime": "SBP",
      "title": "Cloud outsourcing approval, risk controls and exit/portability evidence are current",
      "requiredWhen": ["SBP_CLOUD"],
